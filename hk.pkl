amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

steps {
  ["mise"] = Builtins.mise
  ["cargo-fmt"] = (Builtins.cargo_fmt) {
    exclude = List("fuzz/**")
    check = (Builtins.cargo_fmt.check as Config.CommandSpec) {
      command = "cargo fmt --all --check"
    }
  }
  ["cargo-deny"] = (Builtins.cargo_deny) {
    exclude = List("fuzz/**")
  }
  ["cargo-nextest-default"] {
    exclusive = true
    glob = List("**/*.rs", "Cargo.toml", "Cargo.lock", ".config/nextest.toml")
    exclude = List("fuzz/**")
    check = "cargo nextest run --locked --profile ci"
  }
  ["cargo-nextest-all-features"] {
    exclusive = true
    glob = List("**/*.rs", "Cargo.toml", "Cargo.lock", ".config/nextest.toml")
    exclude = List("fuzz/**")
    check = "cargo nextest run --all-features --locked --profile ci"
  }
  ["cargo-doc"] {
    glob = List("**/*.rs", "Cargo.toml", "Cargo.lock")
    exclude = List("fuzz/**")
    check = "RUSTDOCFLAGS=\"-D warnings\" cargo doc --no-deps --all-features --locked"
  }
  ["cargo-clippy"] = (Builtins.cargo_clippy) {
    exclude = List("fuzz/**")
    check = (Builtins.cargo_clippy.check as Config.CommandSpec) {
      command = "cargo clippy --all-targets --all-features --locked -- -D warnings"
    }
  }
}
